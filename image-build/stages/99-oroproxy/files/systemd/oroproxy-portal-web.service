[Unit]
Description=OroProxy portal web frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/oroproxy/services/portal-web
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 0.0.0.0 --directory /opt/oroproxy/services/portal-web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
