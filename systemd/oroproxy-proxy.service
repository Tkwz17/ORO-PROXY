[Unit]
Description=OroProxy proxy service
After=network.target oroproxy-quota-daemon.service
Wants=oroproxy-quota-daemon.service

[Service]
Type=simple
Environment=OROPROXY_QUOTA_URL=http://127.0.0.1:9090
ExecStart=/opt/oroproxy/services/proxy/proxy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
